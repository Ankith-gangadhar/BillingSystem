{
  "name": "mangalore-store-pos",
  "version": "1.0.0",
  "description": "Mangalore Store Point of Sale & Inventory Management System",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:client && npm run build:server && npm run build:electron",
    "electron:dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\" \"cross-env ELECTRON_DEV=1 electron .\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/db/seed.ts",
    "seed:5k": "tsx server/db/seed5k.ts",
    "backup": "tsx server/scripts/backup.ts"
  },
  "keywords": ["pos", "billing", "inventory", "retail", "sqlite", "offline-first"],
  "author": "Ankith",
  "license": "UNLICENSED",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "minisearch": "^7.1.1",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "@types/canvas-confetti": "^1.9.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
